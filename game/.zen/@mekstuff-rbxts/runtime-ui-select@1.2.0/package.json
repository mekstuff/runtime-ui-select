{
	"name": "@mekstuff-rbxts/runtime-ui-select",
	"private": "true",
	"version": "1.2.0",
	"main": "out/init.luau",
	"files": [
		"out"
	],
	"types": "out/index.d.ts",
	"scripts": {
		"build": "rbxtsc && rojo build -o out/rutus_plugin.rbxm",
		"watch": "rbxtsc -w",
		"dev": "concurrently \"yarn watch\" \"rojo serve serve.project.json\"",
		"dev-game": "cd game && yarn run dev && cd ../",
		"build-game": "cd game && yarn run build && cd ../",
		"zen-pull-game": "cd game && zen pull && zen install yarn && cd ../",
		"zen-publish": "yarn npm pkg set name=@mekstuff-rbxts/runtime-ui-select && zen publish && yarn npm pkg set name=runtime-ui-select && yarn build",
		"sync-game": "yarn zen-publish && yarn run zen-pull-game && yarn run build-game",
		"git-push": "yarn run sync-game && git add game && git commit -m \"chore: synced game\" && git push",
		"prepack": "yarn run build"
	},
	"devDependencies": {
		"@rbxts/compiler-types": "^3.0.0-types.0",
		"@rbxts/types": "^1.0.861",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^11.0.3",
		"@typescript-eslint/eslint-plugin": "^8.35.1",
		"@typescript-eslint/parser": "^8.35.1",
		"concurrently": "^9.2.0",
		"eslint": "^9.30.1",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-prettier": "^5.5.1",
		"eslint-plugin-roblox-ts": "^0.0.36",
		"npm": "^11.4.2",
		"prettier": "^3.6.2",
		"roblox-ts": "^3.0.0",
		"semantic-release": "^24.2.7",
		"semantic-release-export-data": "^1.1.1",
		"typescript": "^5.8.3"
	},
	".zen": {
		"dependencies": {
			"@mekstuff-rbxts/core": {
				"import": true,
				"traverse_imports": true,
				"version": "^0.1.5"
			},
			"@mekstuff-rbxts/vivid-ui": {
				"import": true,
				"traverse_imports": true,
				"version": "^0.1.5"
			},
			"@mekstuff-rbxts/vivid": {
				"import": true,
				"traverse_imports": true,
				"version": "^0.1.0"
			},
			"@mekstuff-rbxts/collector": {
				"import": true,
				"traverse_imports": true,
				"version": "^0.1.6"
			}
		}
	},
	"dependencies": {
		"@mekstuff-rbxts/collector": "file:..\\..\\@mekstuff-rbxts\\collector@0.1.6",
		"@mekstuff-rbxts/core": "file:..\\..\\@mekstuff-rbxts\\core@0.1.5",
		"@mekstuff-rbxts/vivid": "file:..\\..\\@mekstuff-rbxts\\vivid@0.1.0",
		"@mekstuff-rbxts/vivid-ui": "file:..\\..\\@mekstuff-rbxts\\vivid-ui@0.1.5"
	}
}