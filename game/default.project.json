{
	"name": "roblox-ts-game",
	"globIgnorePaths": ["**/tsconfig.json", "out/rutus_game.rbxl"],
	"tree": {
		"$className": "DataModel",
		"ServerScriptService": {
			"$className": "ServerScriptService",
			"TS": {
				"$path": "out/server"
			}
		},
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": {
						"$path": "node_modules/@rbxts"
					},
					"@mekstuff-rbxts": {
						"$path": "node_modules/@mekstuff-rbxts"
					}
				}
			}
		},
		"StarterPlayer": {
			"$className": "StarterPlayer",
			"StarterPlayerScripts": {
				"$className": "StarterPlayerScripts",
				"TS": {
					"$path": "out/client"
				}
			}
		},
		"StarterGui": {
			"$className": "StarterGui",
			"DemoUIs": {
				"$path": "DemoUIs.rbxmx"
			}
		},
		"Workspace": {
			"$className": "Workspace",
			"Baseplate": {
				"$className": "Part",
				"$properties": {
					"Anchored": true,
					"CanCollide": true,
					"Size": { "Vector3": [2048.0, 12.0, 2048.0] }
				}
			},
			"SpawnLocation": {
				"$className": "SpawnLocation",
				"$properties": {
					"Anchored": true,
					"CanCollide": true,
					"Size": { "Vector3": [14.0, 13.0, 14.0] }
				}
			}
		}
	}
}
