{
	"name": "runtime-ui-select-plugin",
	"globIgnorePaths": ["**/tsconfig.json", "out/rutus_plugin.rbxm"],
	"tree": {
		"$path": "out",
		"include": {
			"$path": "include",
			"node_modules": {
				"$className": "Folder",
				"@rbxts": {
					"$path": "node_modules/@rbxts"
				},
				"@mekstuff-rbxts": {
					"$path": "node_modules/@mekstuff-rbxts"
				}
			}
		},
		"package": {
			"$path": "package.json"
		}
	}
}
